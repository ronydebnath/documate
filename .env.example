# Copy to .env and fill in.

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_GENERATOR_MODEL=claude-sonnet-4-6
ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5-20251001

# --- Embeddings (local sentence-transformers; downloaded on first run) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# --- Vector store (ChromaDB, local file-backed) ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=fairwork

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RERANKER_ENABLED=false

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Backend hardening (prod) ---
# slowapi rate limit on /chat. Format: "<count>/<period>", e.g. 10/minute.
CHAT_RATE_LIMIT=10/minute
# Optional shared secret. If set, /chat requires `?key=<DEMO_KEY>` or
# `x-demo-key: <DEMO_KEY>`. Empty string disables the gate.
DEMO_KEY=

# --- Frontend (Next.js reads NEXT_PUBLIC_*) ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Frontend server-side env (used by app/api/chat/route.ts):
# API_URL points at the deployed FastAPI; DEMO_KEY is forwarded as
# x-demo-key when set. Neither is exposed to the browser bundle.
# API_URL=https://documate-api.fly.dev
# DEMO_KEY=
